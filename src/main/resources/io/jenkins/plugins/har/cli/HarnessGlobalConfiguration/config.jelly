<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Harness CLI Configuration">
        <f:description>
            Used to run &lt;code&gt;hc auth login&lt;/code&gt; automatically before the first
            &lt;code&gt;hc&lt;/code&gt; pipeline step in each build.
            API URL and API Token are mandatory; Org ID and Project ID are optional.
        </f:description>
        <f:entry title="API URL"
                 field="apiUrl"
                 description="Harness API endpoint, e.g. https://app.harness.io">
            <f:textbox default="https://app.harness.io"/>
        </f:entry>
        <f:entry title="API Token"
                 field="apiToken"
                 description="Personal Access Token (PAT) from Harness — required">
            <f:password/>
        </f:entry>
        <f:entry title="Organization ID"
                 field="orgId"
                 description="Harness organisation ID (optional, e.g. default)">
            <f:textbox/>
        </f:entry>
        <f:entry title="Project ID"
                 field="projectId"
                 description="Harness project ID (optional)">
            <f:textbox/>
        </f:entry>
    </f:section>
</j:jelly>
