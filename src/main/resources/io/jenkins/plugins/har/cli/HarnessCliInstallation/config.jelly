<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Name}" field="name">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%Harness CLI execution path}" field="home"
             description="Absolute path to the directory containing the hc binary. Leave empty to use the installer.">
        <f:textbox/>
    </f:entry>
</j:jelly>
